class Character:
    def __init__(self, name, level, health, attack):
        self.name = name
        self.level = level
        self.health = health
        self.attack = attack
    def display_info(self):
        print(
            f"Ім'я: {self.name}, Рівень: {self.level}, Здоров'я: {self.health}, Атака: {self.attack}"
        )
    def attack_enemy(self, enemy):
        enemy.health -= self.attack
        print(f"{self.name} атакує {enemy.name} на {self.attack} урону!")
warrior = Character("Warrior", 4, 90, 40)
enemy = Character("Enemy", 1, 70, 5)
enemy.display_info()
warrior.attack_enemy(enemy)
enemy.display_info()

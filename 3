class Character:
    def __init__(self, name, level, health, attack):
        self.name = name
        self.level = level
        self.health = health
        self.attack = attack
    def heal(self, heal):
        if heal < 0:
            heal = 0
        self.health += heal
        print(f"{self.name} відновив здоров'я. Поточне HP: {self.health}")
class Warrior(Character):
    def __init__(self, name, level):
        super().__init__(name, level, 180, 10)
class Mage(Character):
    def __init__(self, name, level, mana):
        super().__init__(name, level, 50, 30)
        self.mana = mana
class Archer(Character):
    def __init__(self, name, level, arrows):
        super().__init__(name, level, 10, 40)
        self.arrows = arrows
w = Warrior("Bob", 4)
m = Mage("John", 5, 100)
a = Archer("Buble", 3, 15)
w.heal(10)
m.heal(100)
a.heal(90)
